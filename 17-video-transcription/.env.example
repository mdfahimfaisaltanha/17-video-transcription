# PostgreSQL connection string (Neon/Supabase free tier works)
DATABASE_URL=postgres://user:password@localhost:5432/seekcast

# OPTIONAL — leave empty for full mock mode:
#   • ingest transcripts as SRT / VTT / "MM:SS text" lines (deterministic parsing)
#   • deterministic mock-v1 embeddings for semantic search
# Set a key to enable:
#   • real speech-to-text on uploaded audio (whisper-1)
#   • text-embedding-3-small for semantic search
OPENAI_API_KEY=

# Password used for the seeded users (scripts/setup.mjs)
SEED_PASSWORD=ChangeMe123!
